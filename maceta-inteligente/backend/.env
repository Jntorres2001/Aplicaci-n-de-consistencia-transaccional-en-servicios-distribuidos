# ==============================
# CONFIGURACIÓN DEL SERVIDOR
# ==============================
PORT=3001
NODE_ENV=development

# ==============================
# BASE DE DATOS MYSQL
# ==============================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=maceta_inteligente

# ==============================
# CONFIGURACIÓN DEL SENSOR (SIMULACIÓN)
# ==============================
# Intervalo en milisegundos entre lecturas del sensor simulado
SENSOR_INTERVAL_MS=4000
# Umbral de humedad para alertas (%)
HUMIDITY_ALERT_THRESHOLD=30
# Umbral de humedad saludable (%)
HUMIDITY_HEALTHY_THRESHOLD=60

# ==============================
# CORS - Origen permitido
# ==============================
FRONTEND_URL=http://localhost:5173
